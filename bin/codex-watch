#!/usr/bin/env node
const fs = require("fs");
const path = require("path");
const os = require("os");
const childProcess = require("child_process");
const crypto = require("node:crypto");
const { StringDecoder } = require("node:string_decoder");

process.stdout.on("error", (error) => {
  if (error.code === "EPIPE") {
    process.exit(0);
  }
  throw error;
});

const args = process.argv.slice(2);
const useColor = !process.env.NO_COLOR && process.stdout.isTTY;
const colors = {
  reset: "\x1b[0m",
  dim: "\x1b[2m",
  gray: "\x1b[90m",
  blue: "\x1b[34m",
  cyan: "\x1b[36m",
  green: "\x1b[32m",
  red: "\x1b[31m",
  yellow: "\x1b[33m",
  assistantBg: "\x1b[48;5;236m"
};

function color(name, value) {
  if (!useColor) {
    return value;
  }
  return colors[name] + value + colors.reset;
}

function assistantText(value) {
  if (!useColor) {
    return value;
  }
  return colors.assistantBg + colors.cyan + value + "\x1b[K" + colors.reset;
}

function printUsage() {
  console.log("Usage: codex-watch [--once] [--job <id>] [--list] [--help]");
  console.log("");
  console.log("Live-tail the newest Codex companion job log for the current git repo.");
  console.log("");
  console.log("Options:");
  console.log("  --once       Render the selected job once and exit");
  console.log("  --job <id>   Tail the job with this id (unique prefix allowed) instead of the newest one");
  console.log("  --list       List this repo's jobs, newest first, and exit");
  console.log("  -h, --help   Show this help");
}

if (args.includes("--help") || args.includes("-h")) {
  printUsage();
  process.exit(0);
}

const once = args.includes("--once");
const list = args.includes("--list");
const jobFlagIndex = args.indexOf("--job");
let pinnedJobId = "";
if (jobFlagIndex !== -1) {
  const value = args[jobFlagIndex + 1];
  if (typeof value !== "string" || !value || value.startsWith("-")) {
    printUsage();
    process.exit(1);
  }
  pinnedJobId = value;
}
if (list && (once || pinnedJobId)) {
  printUsage();
  process.exit(1);
}
const repoRoot = resolveRepoRoot();
const slug = makeSlug(repoRoot);
const stateDirName = makeStateDirName(repoRoot, slug);
const stateRoots = resolveStateRoots();
const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), ".codex");

let currentJob = null;
let logOffset = 0;
let logDecoder = new StringDecoder("utf8");
let pendingText = "";
let assistantBlock = false;
let tailTimer = null;
let scanTimer = null;
let waitingPrinted = false;
let completionBannerPrinted = false;
let sessionInfoPrinted = false;
let requestedSessionInfoPrinted = false;
let resolvedSessionInfoPrinted = false;
let lastSessionInfoLine = "";
let threadIdPrinted = false;
let staleWorkerWarningPrinted = false;
let thinkingIndicatorPrinted = false;
let sessionRolloutPath = "";
let lastRolloutSearchAt = null;
let consumedPatchApplyEvents = new Set();

process.on("SIGINT", () => {
  clearTimers();
  process.stdout.write("\n");
  process.exit(0);
});

if (list) {
  runList();
}

if (once) {
  const job = pinnedJobId ? resolvePinnedJob() : findNewestJob();
  if (!job) {
    console.log("No Codex job found for " + slug + ".");
    process.exit(0);
  }
  printHeader(job);
  printSessionInfo(job);
  printThreadId(job);
  printStaleWorkerWarning(job);
  renderWholeLog(job);
  if (isTerminalStatus(job.status) || isWorkerGone(job)) {
    printCompletionBanner(job, job.displayedCreatedAt);
  }
  process.exit(0);
}

if (pinnedJobId) {
  switchToJob(resolvePinnedJob());
} else {
  startFollow();
}

function resolveRepoRoot() {
  try {
    const output = childProcess.execFileSync("git", ["rev-parse", "--show-toplevel"], {
      cwd: process.cwd(),
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"]
    });
    const trimmed = output.trim();
    return trimmed || process.cwd();
  } catch (_error) {
    return process.cwd();
  }
}

function resolveStateRoots() {
  const pluginDataDir = process.env.CODEX_COMPANION_PLUGIN_DATA || process.env.CLAUDE_PLUGIN_DATA;
  if (pluginDataDir) {
    return [path.join(pluginDataDir, "state")];
  }
  const dataRoot = path.join(os.homedir(), ".claude/plugins/data");
  const roots = [];
  for (const entry of safeReadDir(dataRoot, { withFileTypes: true })) {
    if (entry.isDirectory() || entry.isSymbolicLink()) {
      roots.push(path.join(dataRoot, entry.name, "state"));
    }
  }
  return roots;
}

function makeSlug(root) {
  return path.basename(root).replace(/[^a-zA-Z0-9._-]+/g, "-").replace(/^-+|-+$/g, "") || "workspace";
}

function makeStateDirName(root, rootSlug) {
  let canonical = root;
  try {
    canonical = fs.realpathSync.native(root);
  } catch (_error) {}
  const hash = crypto.createHash("sha256").update(canonical).digest("hex").slice(0, 16);
  return rootSlug + "-" + hash;
}

function safeReadDir(dir, options) {
  try {
    return fs.readdirSync(dir, options);
  } catch (_error) {
    return [];
  }
}

function safeStat(file) {
  try {
    return fs.statSync(file);
  } catch (_error) {
    return null;
  }
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (_error) {
    return {};
  }
}

function collectJobs() {
  const candidates = [];

  for (const stateRoot of stateRoots) {
    const jobsDir = path.join(stateRoot, stateDirName, "jobs");
    const jobEntries = safeReadDir(jobsDir, { withFileTypes: true });

    for (const jobEntry of jobEntries) {
      if (!jobEntry.isFile() || !jobEntry.name.endsWith(".json")) {
        continue;
      }

      const id = path.basename(jobEntry.name, ".json");
      const jsonPath = path.join(jobsDir, jobEntry.name);
      const logPath = path.join(jobsDir, id + ".log");
      const meta = readJson(jsonPath);
      const stat = safeStat(jsonPath);
      const fallbackCreatedAt = stat ? stat.mtime.toISOString() : "";
      const createdAt = typeof meta.createdAt === "string" && meta.createdAt ? meta.createdAt : fallbackCreatedAt;

      candidates.push({
        id,
        jsonPath,
        logPath,
        createdAt,
        displayedCreatedAt: typeof meta.createdAt === "string" && meta.createdAt ? meta.createdAt : createdAt,
        startedAt: typeof meta.startedAt === "string" ? meta.startedAt : "",
        updatedAt: typeof meta.updatedAt === "string" ? meta.updatedAt : "",
        completedAt: typeof meta.completedAt === "string" ? meta.completedAt : "",
        status: typeof meta.status === "string" ? meta.status : "unknown",
        phase: typeof meta.phase === "string" ? meta.phase : "unknown",
        summary: typeof meta.summary === "string" ? meta.summary : "",
        threadId: typeof meta.threadId === "string" ? meta.threadId : "",
        pid: normalizePid(meta.pid),
        request: meta.request && typeof meta.request === "object" ? meta.request : null,
        resolved: normalizeResolved(meta.resolved)
      });
    }
  }

  candidates.sort((a, b) => {
    if (a.createdAt === b.createdAt) {
      return b.id.localeCompare(a.id);
    }
    return a.createdAt < b.createdAt ? 1 : -1;
  });

  return candidates;
}

function findNewestJob() {
  return collectJobs()[0] || null;
}

function resolvePinnedJob() {
  const jobs = collectJobs();
  const exact = jobs.find((job) => job.id === pinnedJobId);
  if (exact) {
    return exact;
  }

  const prefixed = jobs.filter((job) => job.id.startsWith(pinnedJobId));
  if (prefixed.length === 1) {
    return prefixed[0];
  }
  if (prefixed.length > 1) {
    console.error('job id "' + pinnedJobId + '" is ambiguous:');
    for (const job of prefixed) {
      console.error("  " + job.id);
    }
    process.exit(1);
  }

  console.error('job "' + pinnedJobId + '" not found in ' + slug + ".");
  process.exit(1);
}

function startFollow() {
  scanTimer = setInterval(scanForNewJob, 1000);
  scanForNewJob();
}

function scanForNewJob() {
  const newest = findNewestJob();
  if (!newest) {
    if (!waitingPrinted) {
      console.log("waiting for a Codex job in " + slug + "…");
      waitingPrinted = true;
    }
    return;
  }

  if (!currentJob) {
    switchToJob(newest);
    return;
  }

  if (
    newest.createdAt > currentJob.createdAt ||
    (newest.createdAt === currentJob.createdAt && newest.id.localeCompare(currentJob.id) > 0)
  ) {
    console.log(color("dim", "──────── switched to " + newest.id + " ────────"));
    switchToJob(newest);
  }
}

function switchToJob(job) {
  currentJob = job;
  logOffset = 0;
  logDecoder = new StringDecoder("utf8");
  pendingText = "";
  assistantBlock = false;
  waitingPrinted = false;
  completionBannerPrinted = false;
  sessionInfoPrinted = false;
  requestedSessionInfoPrinted = false;
  resolvedSessionInfoPrinted = false;
  lastSessionInfoLine = "";
  threadIdPrinted = false;
  staleWorkerWarningPrinted = false;
  thinkingIndicatorPrinted = false;
  sessionRolloutPath = "";
  lastRolloutSearchAt = null;
  consumedPatchApplyEvents = new Set();
  if (tailTimer) {
    clearInterval(tailTimer);
  }
  printHeader(job);
  printSessionInfo(job);
  printThreadId(job);
  printStaleWorkerWarning(job);
  readAvailableLog();
  tailTimer = setInterval(readAvailableLog, 400);
}

function clearTimers() {
  if (scanTimer) {
    clearInterval(scanTimer);
  }
  if (tailTimer) {
    clearInterval(tailTimer);
  }
}

function printHeader(job) {
  const startedAt = job.startedAt || job.displayedCreatedAt;
  const endedAt = isTerminalStatus(job.status) ? (job.completedAt || job.updatedAt) : "";
  const elapsed = formatElapsed(startedAt, endedAt);
  const title = getThreadTitle(job);
  const line = "job " + job.id + " | status " + job.status + " | phase " + job.phase + " | elapsed " + elapsed +
    (title ? " | " + truncate(title) : "");
  console.log(color("dim", line));
}

function getThreadTitle(job) {
  const title = job.request && job.request.threadTitle;
  return typeof title === "string" ? title.trim() || null : null;
}

function printSessionInfo(job) {
  if (sessionInfoPrinted) {
    return;
  }

  if (!job.threadId) {
    printFallbackSessionInfo(job);
    return;
  }

  if (!resolveSessionRolloutPath(job)) {
    printFallbackSessionInfo(job);
    return;
  }

  const text = readFileText(sessionRolloutPath);
  const startedAt = typeof job.startedAt === "string" && job.startedAt
    ? job.startedAt
    : typeof job.createdAt === "string"
      ? job.createdAt
      : "";
  let turnContext = null;

  for (const line of text.split(/\r?\n/)) {
    try {
      const entry = JSON.parse(line);
      if (
        entry &&
        entry.type === "turn_context" &&
        (!startedAt || (typeof entry.timestamp === "string" && entry.timestamp >= startedAt))
      ) {
        turnContext = entry;
      }
    } catch (_error) {}
  }

  const payload = turnContext && turnContext.payload;
  if (!payload || typeof payload.model !== "string" || !payload.model) {
    printFallbackSessionInfo(job);
    return;
  }

  const segments = ["model " + payload.model];
  if (typeof payload.effort === "string" && payload.effort) {
    segments.push("effort " + payload.effort);
  }
  if (payload.sandbox_policy && typeof payload.sandbox_policy.type === "string" && payload.sandbox_policy.type) {
    segments.push("sandbox " + payload.sandbox_policy.type);
  }
  printSessionInfoLine(segments.join(" · "));
  sessionInfoPrinted = true;
}

function printSessionInfoLine(line) {
  if (line === lastSessionInfoLine) {
    return;
  }
  console.log(color("dim", line));
  lastSessionInfoLine = line;
}

function printThreadId(job) {
  if (threadIdPrinted || !job.threadId) {
    return;
  }
  console.log(color("dim", "thread " + job.threadId));
  threadIdPrinted = true;
}

function printRequestedSessionInfo(job) {
  const request = job.request;
  if (
    requestedSessionInfoPrinted ||
    !request ||
    typeof request.model !== "string" ||
    !request.model
  ) {
    return;
  }

  const segments = ["model " + request.model + " (requested)"];
  if (typeof request.effort === "string" && request.effort) {
    segments.push("effort " + request.effort + " (requested)");
  }
  printSessionInfoLine(segments.join(" · "));
  requestedSessionInfoPrinted = true;
}

function printFallbackSessionInfo(job) {
  if (printResolvedSessionInfo(job)) {
    return;
  }
  printRequestedSessionInfo(job);
}

function printResolvedSessionInfo(job) {
  if (resolvedSessionInfoPrinted) {
    return true;
  }
  const resolved = job.resolved;
  if (!resolved || typeof resolved.model !== "string" || !resolved.model) {
    return false;
  }

  const segments = ["model " + resolved.model];
  if (typeof resolved.reasoningEffort === "string" && resolved.reasoningEffort) {
    segments.push("effort " + resolved.reasoningEffort);
  }
  if (
    resolved.sandbox &&
    typeof resolved.sandbox === "object" &&
    typeof resolved.sandbox.type === "string" &&
    resolved.sandbox.type
  ) {
    segments.push("sandbox " + camelToKebab(resolved.sandbox.type));
  }
  printSessionInfoLine(segments.join(" · "));
  resolvedSessionInfoPrinted = true;
  return true;
}

function normalizeResolved(value) {
  return value && typeof value === "object" && !Array.isArray(value) ? value : null;
}

function normalizePid(value) {
  return typeof value === "number" && Number.isFinite(value) && value > 0 ? value : null;
}

function printStaleWorkerWarning(job) {
  if (staleWorkerWarningPrinted || !isWorkerGone(job)) {
    return;
  }
  console.log(color("red", "⚠ worker pid " + job.pid + " is gone — job record is stale"));
  staleWorkerWarningPrinted = true;
}

function isWorkerGone(job) {
  return (job.status === "queued" || job.status === "running") &&
    Number.isFinite(job.pid) && job.pid > 0 && !isProcessAlive(job.pid);
}

function isProcessAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return !error || error.code !== "ESRCH";
  }
}

function camelToKebab(value) {
  return value.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
}

function resolveSessionRolloutPath(job) {
  if (sessionRolloutPath) {
    return sessionRolloutPath;
  }
  if (!job || !job.threadId) {
    return "";
  }

  const now = Date.now();
  if (lastRolloutSearchAt !== null && now - lastRolloutSearchAt < 5000) {
    return "";
  }
  lastRolloutSearchAt = now;
  sessionRolloutPath = findRolloutFile(job.threadId);
  return sessionRolloutPath;
}

function findRolloutFile(threadId) {
  const sessionsRoot = path.join(codexHome, "sessions");
  const years = safeReadDir(sessionsRoot, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
    .sort()
    .reverse();

  for (const year of years) {
    const yearDir = path.join(sessionsRoot, year);
    const months = safeReadDir(yearDir, { withFileTypes: true })
      .filter((entry) => entry.isDirectory())
      .map((entry) => entry.name)
      .sort()
      .reverse();

    for (const month of months) {
      const monthDir = path.join(yearDir, month);
      const days = safeReadDir(monthDir, { withFileTypes: true })
        .filter((entry) => entry.isDirectory())
        .map((entry) => entry.name)
        .sort()
        .reverse();

      for (const day of days) {
        const dayDir = path.join(monthDir, day);
        const rollout = safeReadDir(dayDir, { withFileTypes: true }).find(
          (entry) => entry.isFile() && entry.name.endsWith("-" + threadId + ".jsonl")
        );
        if (rollout) {
          return path.join(dayDir, rollout.name);
        }
      }
    }
  }

  return "";
}

function formatElapsed(createdAt, updatedAt) {
  const started = Date.parse(createdAt);
  if (!Number.isFinite(started)) {
    return "unknown";
  }
  const ended = updatedAt ? Date.parse(updatedAt) : Date.now();
  const elapsedUntil = Number.isFinite(ended) ? ended : Date.now();
  const seconds = Math.max(0, Math.floor((elapsedUntil - started) / 1000));
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const remainingSeconds = seconds % 60;
  if (hours > 0) {
    return hours + "h " + minutes + "m " + remainingSeconds + "s";
  }
  if (minutes > 0) {
    return minutes + "m " + remainingSeconds + "s";
  }
  return remainingSeconds + "s";
}

function renderWholeLog(job) {
  const text = readFileText(job.logPath);
  renderText(text, false, job);
}

function readAvailableLog() {
  if (!currentJob) {
    return;
  }

  const stat = safeStat(currentJob.logPath);
  if (stat && stat.isFile()) {
    if (stat.size < logOffset) {
      logOffset = 0;
      logDecoder = new StringDecoder("utf8");
      pendingText = "";
      assistantBlock = false;
    }

    if (stat.size !== logOffset) {
      const chunk = readFileChunk(currentJob.logPath, logOffset, stat.size - logOffset);
      if (chunk !== null) {
        logOffset += chunk.length;
        renderText(logDecoder.write(chunk), true, currentJob);
      }
    }
  }

  checkJobCompletion();
}

function checkJobCompletion() {
  let meta = null;
  try {
    meta = JSON.parse(fs.readFileSync(currentJob.jsonPath, "utf8"));
  } catch (_error) {
    if (pinnedJobId && !safeStat(currentJob.jsonPath)) {
      console.log(color("dim", "job record " + currentJob.id + " is gone — stopping."));
      clearTimers();
      process.exit(0);
    }
    return;
  }

  const status = typeof meta.status === "string" ? meta.status : "unknown";
  currentJob.status = status;
  currentJob.threadId = typeof meta.threadId === "string" ? meta.threadId : "";
  currentJob.pid = normalizePid(meta.pid);
  currentJob.startedAt = typeof meta.startedAt === "string" ? meta.startedAt : "";
  currentJob.request = meta.request && typeof meta.request === "object" ? meta.request : null;
  currentJob.resolved = normalizeResolved(meta.resolved);
  printThreadId(currentJob);
  printSessionInfo(currentJob);
  printStaleWorkerWarning(currentJob);
  if (completionBannerPrinted) {
    return;
  }
  if (!isTerminalStatus(status) && !isWorkerGone(currentJob)) {
    return;
  }

  printCompletionBanner(meta, currentJob.displayedCreatedAt);
  completionBannerPrinted = true;
  if (pinnedJobId) {
    clearTimers();
    process.exit(0);
  }
}

function printCompletionBanner(job, fallbackCreatedAt) {
  const status = typeof job.status === "string" ? job.status : "unknown";
  const createdAt = typeof job.createdAt === "string" && job.createdAt ? job.createdAt : fallbackCreatedAt;
  const startedAt = typeof job.startedAt === "string" && job.startedAt ? job.startedAt : createdAt;
  if (isWorkerGone(job)) {
    console.log(color("red", "✗ failed (worker exited) · " + formatElapsed(startedAt)));
    return;
  }
  const updatedAt = typeof job.updatedAt === "string" && job.updatedAt ? job.updatedAt : "";
  const completedAt = typeof job.completedAt === "string" && job.completedAt ? job.completedAt : updatedAt;
  const elapsed = formatElapsed(startedAt, completedAt);
  if (status === "completed") {
    console.log(color("green", "✓ completed · " + elapsed));
  } else {
    console.log(color("red", "✗ " + status + " · " + elapsed));
  }
}

function runList() {
  const jobs = collectJobs();
  if (jobs.length === 0) {
    console.log("No Codex job found for " + slug + ".");
    process.exit(0);
  }

  const idWidth = Math.max(...jobs.map((job) => job.id.length));
  const displayedStatuses = jobs.map((job) => isWorkerGone(job) ? "failed" : job.status);
  const statusWidth = Math.max(...displayedStatuses.map((status) => status.length));

  for (const [index, job] of jobs.entries()) {
    const status = displayedStatuses[index];
    const marker = index === 0 ? "*" : " ";
    const startedAt = job.startedAt || job.displayedCreatedAt;
    const endedAt = isTerminalStatus(job.status) ? (job.completedAt || job.updatedAt) : "";
    const segments = [
      marker + " " + job.id.padEnd(idWidth),
      statusColor(status, status.padEnd(statusWidth)),
      "started " + formatClock(job.displayedCreatedAt) + " (" + formatElapsed(startedAt, endedAt) + ")"
    ];
    const label = getThreadTitle(job) || job.summary;
    if (label) {
      segments.push(truncate(label));
    }
    console.log(segments.join("  ").trimEnd());
  }
  process.exit(0);
}

function statusColor(status, value) {
  if (status === "completed") {
    return color("green", value);
  }
  if (status === "running" || status === "queued") {
    return value;
  }
  return color("red", value);
}

function formatClock(createdAt) {
  const parsed = new Date(createdAt);
  if (Number.isNaN(parsed.getTime())) {
    return "unknown";
  }
  const pad = (value) => String(value).padStart(2, "0");
  return pad(parsed.getHours()) + ":" + pad(parsed.getMinutes()) + ":" + pad(parsed.getSeconds());
}

function isTerminalStatus(status) {
  return status !== "running" && status !== "queued";
}

function readFileText(file) {
  try {
    return fs.readFileSync(file, "utf8");
  } catch (_error) {
    return "";
  }
}

function readFileChunk(file, start, length) {
  let fd = null;
  try {
    fd = fs.openSync(file, "r");
    const buffer = Buffer.alloc(length);
    const bytesRead = fs.readSync(fd, buffer, 0, length, start);
    return buffer.subarray(0, bytesRead);
  } catch (_error) {
    return null;
  } finally {
    if (fd !== null) {
      try {
        fs.closeSync(fd);
      } catch (_error) {}
    }
  }
}

function renderText(text, keepPartial, job) {
  if (!text) {
    return;
  }

  const combined = pendingText + text;
  const endsWithNewline = /\r?\n$/.test(combined);
  const lines = combined.split(/\r?\n/);
  pendingText = "";

  if (!endsWithNewline && keepPartial) {
    pendingText = lines.pop() || "";
  } else if (endsWithNewline) {
    lines.pop();
  }

  for (const line of lines) {
    renderLine(line, job);
  }
}

function renderLine(line, job) {
  const match = line.match(/^\[(\d{4}-\d{2}-\d{2}T[^\]]*)\]\s+(.*)$/);
  if (!match) {
    thinkingIndicatorPrinted = false;
    if (assistantBlock) {
      console.log(assistantText(line));
    } else {
      console.log(line);
    }
    return;
  }

  const eventTimestamp = match[1];
  const event = match[2];

  if (event === "Assistant message") {
    assistantBlock = true;
    return;
  }

  assistantBlock = false;

  if (event.startsWith("Assistant message captured:")) {
    return;
  }

  if (event === "Thinking.") {
    if (!thinkingIndicatorPrinted) {
      console.log(color("dim", "Thinking..."));
      thinkingIndicatorPrinted = true;
    }
    return;
  }

  thinkingIndicatorPrinted = false;

  if (event.startsWith("Running command: ")) {
    console.log(color("dim", color("blue", "Running command: " + truncate(event.slice("Running command: ".length)))));
    return;
  }

  const completed = event.match(/^Command completed: (.*) \(exit ([0-9]+)\)$/);
  if (completed) {
    const message = "Command completed: " + truncate(completed[1]) + " (exit " + completed[2] + ")";
    if (completed[2] === "0") {
      console.log(color("green", "✓ " + message));
    } else {
      console.log(color("red", "✗ " + message));
    }
    return;
  }

  if (event.startsWith("Command failed")) {
    console.log(color("red", "✗ " + event));
    return;
  }

  if (/^Applying [0-9]+ file change\(s\)\.$/.test(event)) {
    console.log(color("yellow", event));
    renderAppliedFiles(eventTimestamp, job);
    return;
  }

  if (event.startsWith("File changes") || event === "File changes completed.") {
    console.log(color("yellow", event));
    return;
  }

  if (/^(Turn started|Turn completed|Thread ready|Final output)\b/.test(event)) {
    console.log(color("gray", event));
    return;
  }

  console.log(event);
}

function renderAppliedFiles(eventTimestamp, job) {
  const rolloutPath = resolveSessionRolloutPath(job);
  if (!rolloutPath) {
    return;
  }

  const targetTime = Date.parse(eventTimestamp);
  if (!Number.isFinite(targetTime)) {
    return;
  }

  const text = readFileText(rolloutPath);
  let sessionCwd = process.cwd();
  let nearest = null;

  for (const [index, line] of text.split(/\r?\n/).entries()) {
    try {
      const entry = JSON.parse(line);
      if (
        entry &&
        entry.type === "session_meta" &&
        entry.payload &&
        typeof entry.payload.cwd === "string" &&
        entry.payload.cwd
      ) {
        sessionCwd = entry.payload.cwd;
      }
      if (
        consumedPatchApplyEvents.has(index) ||
        !entry ||
        entry.type !== "event_msg" ||
        !entry.payload ||
        entry.payload.type !== "patch_apply_end"
      ) {
        continue;
      }

      const patchTime = Date.parse(entry.timestamp);
      const difference = Math.abs(patchTime - targetTime);
      if (!Number.isFinite(difference) || difference > 2000) {
        continue;
      }
      if (!nearest || difference < nearest.difference) {
        nearest = { index, difference, changes: entry.payload.changes };
      }
    } catch (_error) {}
  }

  if (!nearest) {
    return;
  }
  consumedPatchApplyEvents.add(nearest.index);
  if (!nearest.changes || typeof nearest.changes !== "object" || Array.isArray(nearest.changes)) {
    return;
  }

  for (const [file, change] of Object.entries(nearest.changes)) {
    const type = change && change.type;
    const marker = type === "update" ? "M" : type === "add" ? "A" : type === "delete" ? "D" : String(type);
    console.log(color("dim", "  " + marker + " " + renderChangedPath(file, sessionCwd)));
  }
}

function renderChangedPath(file, sessionCwd) {
  if (!path.isAbsolute(file)) {
    return file;
  }

  const relative = path.relative(sessionCwd, file);
  if (relative !== ".." && !relative.startsWith(".." + path.sep) && !path.isAbsolute(relative)) {
    return relative || ".";
  }
  return file;
}

function truncate(value) {
  const maxLength = 140;
  const codePoints = Array.from(value);
  if (codePoints.length <= maxLength) {
    return value;
  }
  return codePoints.slice(0, maxLength - 1).join("") + "…";
}
